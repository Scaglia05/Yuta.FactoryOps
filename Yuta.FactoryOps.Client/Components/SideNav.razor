@using Yuta.FactoryOps.Client.Security

<div class="side-nav">
    <div class="side-nav-header">
        <div class="logo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span>YUTA</span>
        </div>
    </div>

    <nav class="side-nav-links">
        <a href="/dashboard" class="nav-item @IsActive("/dashboard")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
            </svg>
            <span>Dashboard</span>
        </a>

        <a href="/usuarios" class="nav-item @IsActive("/usuarios")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>Usuários</span>
        </a>

        <a href="/empresas" class="nav-item @IsActive("/empresas")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            <span>Empresas</span>
        </a>

        <a href="/admin" class="nav-item @IsActive("/admin")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Painel Administrativo</span>
        </a>

    </nav>

    <div class="side-nav-footer">
        <button class="theme-toggle-btn" @onclick="ToggleTheme" title="Alternar tema claro/escuro">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
            </svg>
            <span>Tema</span>
        </button>
        <button class="logout-btn" @onclick="Logout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span>Sair</span>
        </button>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    [Inject]
    private ProvedorAutenticacaoJwt ProvedorAuth { get; set; } = null!;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private string IsActive(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private async Task ToggleTheme()
    {
        await JS.InvokeVoidAsync("fops.toggleLayoutTheme", ".main-layout");
    }

    private async Task Logout()
    {
        await ProvedorAuth.MarcarComoDeslogado();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}