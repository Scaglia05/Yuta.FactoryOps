@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Yuta.FactoryOps.Client.Components

<div class="main-layout" data-theme="dark">
    <SideNav />

    <div class="main-content">
        @Body
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("fops.applyLayoutTheme", ".main-layout");
        }
    }
}

<style>
.main-layout {
    display: flex;
    min-height: 100vh;
    background: #f8fafc;
    transition: background-color .3s ease;
}

.main-content {
    flex: 1;
    margin-left: 260px;
    padding: 32px;
    overflow-y: auto;
}

@@media screen and (max-width: 768px) {
    .main-content {
        margin-left: 70px;
        padding: 20px;
    }
}
</style>